# Copy to .env and fill in.  ./scripts/gen-secrets.sh prints random values for the secrets.
# .env is git-ignored. Never commit it.

# ── General ──────────────────────────────────────────────
TZ=America/Santiago
DOMAIN=ailabs.cl                  # Cloudflare zone

# Tailscale machine name of THIS host (= NODE_NAME in node/.env). Shown on the dashboard.
# Change it if the core moves to another machine.
CORE_NAME=jaime-pi

# Tailscale IP of THIS host (tailscale ip -4). Agent ports (Komodo, Beszel, CrowdSec)
# bind only to it so other machines' agents can reach the core.
TAILSCALE_IP=100.x.y.z

# Tailnet DNS suffix (Tailscale admin > DNS, or: tailscale status --json | jq -r .MagicDNSSuffix).
# Lets Gatus check machines by name (icmp://media-pc).
TAILNET_DOMAIN=tailXXXXXX.ts.net

# ── Cloudflare ───────────────────────────────────────────
# Token of the "mgmt" tunnel (Zero Trust > Networks > Tunnels)
CLOUDFLARE_TUNNEL_TOKEN=

# ── Optional: VPN-only path *.lab.DOMAIN (compose.tailnet.yaml) ──
# COMPOSE_FILE=compose.yaml:compose.tailnet.yaml
# ACME_EMAIL=you@example.com
# CF_DNS_API_TOKEN=          # Zone:DNS:Edit on DOMAIN, for the *.lab certificate

# ── CrowdSec ─────────────────────────────────────────────
CROWDSEC_BOUNCER_KEY=

# ── Gatus (uptime checks) ────────────────────────────────
# ntfy access token for alerts (docs/operations.md § Notifications): docker exec ntfy ntfy token add jaime
GATUS_NTFY_TOKEN=

# ── authentik (optional SSO layer) ───────────────────────
# Off by default: Cloudflare Access is the login. To enable it (docs/access.md § 2):
# COMPOSE_PROFILES=authentik
# Pin to the current stable release: https://docs.goauthentik.io/releases
AUTHENTIK_TAG=2026.8
AUTHENTIK_SECRET_KEY=
AUTHENTIK_PG_PASS=

# ── Komodo ───────────────────────────────────────────────
KOMODO_DB_USERNAME=komodo
KOMODO_DB_PASSWORD=
KOMODO_JWT_SECRET=
KOMODO_WEBHOOK_SECRET=
KOMODO_INIT_ADMIN_USERNAME=admin
KOMODO_INIT_ADMIN_PASSWORD=
# Only with authentik: fill after creating the "komodo" OAuth2 provider (docs/access.md § 2)
KOMODO_OIDC_ENABLED=false
KOMODO_OIDC_CLIENT_ID=
KOMODO_OIDC_CLIENT_SECRET=
