# Copy to homepage.env (git-ignored). Read by the homepage container only.
# Referenced in homepage/services.yaml as {{HOMEPAGE_VAR_NAME}}.

HOMEPAGE_VAR_DOMAIN=ailabs.cl

# Komodo: Settings > API keys
HOMEPAGE_VAR_KOMODO_KEY=
HOMEPAGE_VAR_KOMODO_SECRET=

# Beszel: a read-only user created in the Beszel UI
HOMEPAGE_VAR_BESZEL_USER=
HOMEPAGE_VAR_BESZEL_PASS=

# authentik: Admin > Directory > Tokens (API token)
HOMEPAGE_VAR_AUTHENTIK_TOKEN=

# CrowdSec: docker exec crowdsec cscli machines add homepage --password <pw> -f /dev/null
HOMEPAGE_VAR_CROWDSEC_USER=homepage
HOMEPAGE_VAR_CROWDSEC_PASS=
