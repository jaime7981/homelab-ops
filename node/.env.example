# Copy to .env on each machine (git-ignored).

TZ=America/Santiago

# Name shown in Komodo / Beszel / CrowdSec. Use the Tailscale machine name.
NODE_NAME=media-pc

# Tailscale IP of the management core host (tailscale ip -4 on the core).
# Use the IP, not the MagicDNS name: containers don't always resolve MagicDNS.
CORE_HOST=100.x.y.z

# Komodo > Settings > Onboarding keys. Only needed the first time a server connects.
KOMODO_ONBOARDING_KEY=

# Beszel > Add system > shows KEY and TOKEN for this machine.
BESZEL_KEY=
BESZEL_TOKEN=

# Only if you run the crowdsec profile:
#   on core: docker exec crowdsec cscli machines add <NODE_NAME> --password <pw> -f /dev/null
CROWDSEC_AGENT_PASSWORD=
